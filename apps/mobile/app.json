{
  "expo": {
    "name": "Portfoliofy",
    "slug": "portfoliofy",
    "version": "2.0.0",
    "scheme": "com.portfoliofy.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.portfoliofy.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#222222",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
