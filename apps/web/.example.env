# ==========================================
# Site
# ==========================================
# Public origin of this deployment, no trailing slash, e.g. https://portfoliofy.site
# Build-time: changing it needs a redeploy. Subdomains are enabled only on a domain you own.
NEXT_PUBLIC_SITE_URL=

# ==========================================
# Authentication (NextAuth & Google OAuth)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# ==========================================
# Database (Supabase Postgres)
# ==========================================
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ==========================================
# Image Storage & CDN (AWS S3 & CloudFront)
# ==========================================
S3_UPLOAD_BUCKET=
S3_UPLOAD_KEY=
S3_UPLOAD_REGION=
S3_UPLOAD_SECRET=
NEXT_PUBLIC_CDN_URL=

# ==========================================
# AI (resume import)
# ==========================================
GEMINI_API_KEY=

# ==========================================
# Analytics
# ==========================================
NEXT_PUBLIC_GA_ID=

# ==========================================
# Vercel Configuration
# ==========================================
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only for projects under a team; used when adding custom domains.
VERCEL_TEAM_ID=
VERCEL_OIDC_TOKEN=

# ==========================================
# Rate Limiting (Upstash Redis)
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret that authorizes the scheduled keep-alive request (production).
CRON_SECRET=

# ==========================================
# Android app (Trusted Web Activity)
# ==========================================
# Package ID chosen when generating the app, e.g. com.portfoliofy.app
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 fingerprints (upload key and Play app signing key)
ANDROID_CERT_FINGERPRINTS=

# ==========================================
# Email sign-in (magic link)
# ==========================================
# Set to true to show "Continue with email" in the sign-in dialog.
NEXT_PUBLIC_EMAIL_AUTH=
# Resend API key and verified sender, e.g. "Portfoliofy <login@yourdomain.com>".
# With no key, local development prints the link in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=

# ==========================================
# Google Play reviewer sign-in
# ==========================================
# A fixed address that signs in with a fixed code instead of an emailed link,
# because Play's reviewers can't read an inbox. Both must be set, and the code
# needs at least 16 characters, or the feature stays off.
REVIEWER_EMAIL=
REVIEWER_CODE=
