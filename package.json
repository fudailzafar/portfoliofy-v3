{
  "name": "portfoliofy",
  "version": "0.1.0",
  "private": true,
  "description": "A drag-and-drop portfolio builder for professionals — customizable sections, integrated writing, and profiles that are genuinely yours.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fudailzafar/portfoliofy-v3.git"
  },
  "license": "MIT",
  "author": "Fudail Mohammed Zafar",
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "dev": "pnpm --filter @portfoliofy/web dev",
    "build": "pnpm --filter @portfoliofy/web build",
    "start": "pnpm --filter @portfoliofy/web start",
    "lint": "pnpm --filter @portfoliofy/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "prepare": "husky",
    "dev:mobile": "pnpm --filter @portfoliofy/mobile start"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx}": "pnpm --filter @portfoliofy/web exec eslint --fix",
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "16.2.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15"
    }
  }
}
